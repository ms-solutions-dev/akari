    "widget.listen.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Hörbuch mit Kapitel und Restzeit — Play und Pause direkt im Widget."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your audiobook with chapter and time left — play and pause right in the widget."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli kitabın, bölüm ve kalan süreyle — oynat ve duraklat doğrudan widget’ta."
          }
        }
      }
    },
