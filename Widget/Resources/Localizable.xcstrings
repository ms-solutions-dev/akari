{
  "sourceLanguage": "en",
  "strings": {
    "intent.continueListening.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt das zuletzt gehörte Hörbuch weiter oder hält es an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumes or pauses the audiobook you last listened to."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son dinlenen sesli kitabı sürdürür ya da duraklatır."
          }
        }
      }
    },
    "intent.continueListening.identifier": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hörbuch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
