    "widget.statistics.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesezeit heute und diese Woche, Seiten, beendete Titel, Lesetage — ein Tipp öffnet die Statistik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading time today and this week, pages, finished titles, reading days — one tap opens the stats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün ve bu hafta okuma süresi, sayfalar, bitirilen başlıklar, okuma günleri — bir dokunuş istatistikleri açar."
          }
        }
      }
    },
    "widget.statistics.empty.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies ein paar Minuten — die Zahlen stehen dann hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read for a few minutes – the numbers show up here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç dakika oku – rakamlar burada görünür."
          }
        }
      }
    },
