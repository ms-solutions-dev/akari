    "widget.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine angefangenen Bücher, Manga und Hörbücher — ein Tipp öffnet den Reader."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your started books, manga and audiobooks — one tap opens the reader."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başladığın kitaplar, mangalar ve sesli kitaplar — bir dokunuş okuyucuyu açar."
          }
        }
      }
    },
    "widget.empty.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such dir etwas aus — tippen öffnet Akari."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick something — tap to open Akari."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey seç — dokununca Akari açılır."
          }
        }
      }
    },
