    "account.webdav.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse des Ordners auf deinem Server — bei Nextcloud in der Form https://…/remote.php/dav/files/<name>/<Ordner>. Dort am besten ein App-Passwort (Einstellungen → Sicherheit). Name und Passwort nur, wenn der Ordner sie verlangt. Der Lesestand bleibt auf diesem Gerät — WebDAV kennt keinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address of the folder on your server – for Nextcloud in the form https://…/remote.php/dav/files/<name>/<folder>. Preferably use an app password there (Settings → Security). Name and password only if the folder asks for them. Reading progress stays on this device – WebDAV has none."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucundaki klasörün adresi – Nextcloud’da https://…/remote.php/dav/files/<ad>/<klasör> biçiminde. Orada tercihen bir uygulama parolası kullan (Ayarlar → Güvenlik). Ad ve parola yalnızca klasör istiyorsa. Okuma durumu bu cihazda kalır – WebDAV bunu bilmez."
          }
        }
      }
    },
