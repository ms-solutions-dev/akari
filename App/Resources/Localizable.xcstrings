    "profile.adopt.owner": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dem anderen Gerät"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
