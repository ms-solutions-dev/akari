    "diagnostics.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet Hänger, Ruckeln, CPU-Last und Speicher auf, je Bereich der App. Kostet etwas Akku, solange es an ist. Die Berichte von Apple (MetricKit) kommen immer dazu. Nichts verlässt das Gerät, bis du den Bericht teilst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records hangs, stutter, CPU load and memory for each area of the app. Uses some battery while on. Apple's reports (MetricKit) are always included. Nothing leaves the device until you share the report."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın her bölümü için takılmaları, kasılmaları, CPU yükünü ve belleği kaydeder. Açıkken biraz pil harcar. Apple raporları (MetricKit) her zaman eklenir. Raporu paylaşana kadar hiçbir şey cihazdan çıkmaz."
          }
        }
      }
    },
