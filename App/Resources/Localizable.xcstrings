    "cloud.device.add.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem anderen Gerät scannen — mit der Kamera oder in Akari unter Profil → Neues Profil → Von einem anderen Gerät holen. Es nimmt die Freigabe an, legt das Profil an und fragt nur noch die Passwörter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with the other device — with the camera or in Akari under Profile → New profile → Get from another device. It accepts the share, creates the profile and only asks for the passwords."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cihazla tara — kamerayla veya Akari'de Profil → Yeni profil → Başka bir cihazdan al. Paylaşımı kabul eder, profili oluşturur ve yalnızca parolaları sorar."
          }
        }
      }
    },
