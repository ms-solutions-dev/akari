    "profile.remove.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt %@ mit den Konten, der Merkliste und den Leseständen auf diesem Gerät. Heruntergeladene Bücher bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes %@ with the accounts, saved list and reading progress on this device. Downloaded books stay."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ profilini bu cihazdaki hesapları, kaydedilenler listesi ve okuma durumlarıyla birlikte kaldırır. İndirilen kitaplar kalır."
          }
        }
      }
    },
    "profile.remove.text.short": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten, Gemerkt und Lesestände dieses Profils auf diesem Gerät gehen verloren. Heruntergeladenes bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile's accounts, saved list and reading progress on this device will be lost. Downloads stay."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin bu cihazdaki hesapları, kaydedilenleri ve okuma durumları silinir. İndirilenler kalır."
          }
        }
      }
    },
