    "collection.empty.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Cover gedrückt und wähle „Ins Regal …“ – Regale bei Grimmory, Leselisten bei Komga, Playlists bei Audiobookshelf. Eine Reihe wie „Sherlock Holmes“ ist kein Regal, sondern steht unter „Reihen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold a cover and choose “Put on Shelf…” – shelves on Grimmory, reading lists on Komga, playlists on Audiobookshelf. A series like “Sherlock Holmes” is not a shelf – it lives under “Series”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kapağa basılı tut ve “Rafa koy…”u seç – Grimmory’de raflar, Komga’da okuma listeleri, Audiobookshelf’te çalma listeleri. “Sherlock Holmes” gibi bir seri raf değildir, “Seriler” altında durur."
          }
        }
      }
    },
