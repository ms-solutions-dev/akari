      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse des Servers reicht – Akari hängt den Katalog %@ an. Name und Passwort nur, wenn der Server sie verlangt. Der Lesestand bleibt auf diesem Gerät – OPDS kennt keinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address is enough – Akari adds the catalog %@. Name and password only if the server asks for them. Reading progress stays on this device – OPDS has none."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu adresi yeterli – Akari kataloğu (%@) kendisi ekler. Ad ve parola yalnızca sunucu istiyorsa. Okuma durumu bu cihazda kalır – OPDS bunu bilmez."
