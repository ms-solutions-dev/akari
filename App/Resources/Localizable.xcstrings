      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe verlassen und Profil entfernen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the share and remove the profile?"
          }
        },
        "tr": {
