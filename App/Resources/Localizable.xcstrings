    "profile.pinHint.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat noch keine PIN — ein Kind wechselt dann mit einem Tipp dorthin. Unter „Verwalten“ lässt sich eine setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no PIN yet — a child can switch there with a tap. You can set one under “Manage”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ henüz PIN'siz — bir çocuk tek dokunuşla oraya geçebilir. “Yönet” altından bir PIN belirlenebilir."
          }
        }
      }
    },
    "profile.pinHint.title": {
      "extractionState": "manual",
