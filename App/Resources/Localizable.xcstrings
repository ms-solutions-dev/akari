    "cloud.device.name.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So erscheint es unter „iCloud & Geräte“ auf allen Geräten dieses Profils. Später jederzeit umbenennbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how it appears under “iCloud & Devices” on all devices of this profile. You can rename it any time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin tüm cihazlarında “iCloud ve Cihazlar” altında böyle görünür. İstediğin zaman yeniden adlandırabilirsin."
          }
        }
      }
    },
