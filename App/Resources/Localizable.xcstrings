    "certificate.changed.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server zeigte bisher ein anderes Zertifikat. Wenn du es nicht selbst erneuert hast: nicht vertrauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server used to show a different certificate. If you didn't renew it yourself: don't trust it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu daha önce farklı bir sertifika gösteriyordu. Kendin yenilemediysen: güvenme."
          }
        }
      }
    },
