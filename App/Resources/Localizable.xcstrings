        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your shelf.\nFrom your server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafın.\nKendi sunucundan."
          }
        }
      }
