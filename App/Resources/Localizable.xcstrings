    "profile.pin.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PIN wird nur beim Wechsel zu diesem Profil gefragt und bleibt auf dem Gerät — niemand sonst kann sie lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN is asked only when switching to this profile and stays on the device — nobody else can read it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN yalnızca bu profile geçerken sorulur ve cihazda kalır — başka kimse okuyamaz."
          }
        }
      }
    },
    "profile.pin.unequal": {
      "extractionState": "manual",
      "localizations": {
