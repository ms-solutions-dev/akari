    "account.folderList": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV-Ordner"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV folders"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV klasörleri"
          }
        }
      }
    },
    "account.folderList.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nextcloud, ownCloud oder jeder andere WebDAV-Server. EPUB, PDF, CBZ und CBR aus dem Ordner stehen im Regal; Name, Autor und Reihe kommen aus Pfad und Datei. Der Lesestand bleibt auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nextcloud, ownCloud or any other WebDAV server. EPUB, PDF, CBZ and CBR files in the folder appear on the shelf; title, author and series come from path and file. Reading progress stays on the device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nextcloud, ownCloud ya da başka bir WebDAV sunucusu. Klasördeki EPUB, PDF, CBZ ve CBR dosyaları rafta görünür; ad, yazar ve seri yol ve dosyadan gelir. Okuma durumu cihazda kalır."
          }
        }
      }
    },
    "account.kavita.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name und Passwort deines Kavita-Kontos. Akari legt damit einen eigenen Schlüssel an, das Passwort wird nicht gespeichert. Der Lesestand geht an Kavita zurück. EPUBs öffnen braucht das Recht „Download“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name and password of your Kavita account. Akari creates its own key with them; the password is not stored. Your progress goes back to Kavita. Opening EPUBs needs the “Download” permission."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kavita hesabının adı ve şifresi. Akari bunlarla kendi anahtarını oluşturur; şifre kaydedilmez. Okuma durumun Kavita’ya geri gider. EPUB açmak için “Download” yetkisi gerekir."
          }
        }
      }
    },
