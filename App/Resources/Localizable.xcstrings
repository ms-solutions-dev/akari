    "setUp.code.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein QR-Code vom Server trägt Adressen und Zertifikat. Danach fehlen nur Name und Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A QR code from the server carries addresses and certificate. After that only name and password are missing."
