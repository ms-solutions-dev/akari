    "account.catalog.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App holt beim Abgleichen nur, was sich geändert hat. Neu aufbauen lädt alles noch einmal – bei großen Bibliotheken dauert das einen Moment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing only fetches what changed. Rebuilding loads everything again – this takes a moment for large libraries."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitleme yalnızca değişenleri alır. Yeniden oluşturma her şeyi tekrar yükler – büyük kitaplıklarda biraz sürer."
          }
        }
      }
    },
    "account.catalog.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
