            "state": "translated",
            "value": "Name or password is wrong."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad veya parola yanlış."
          }
        }
      }
    },
    "account.error.address": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine Serveradresse. Beispiel: komga.example.com"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's not a server address. Example: komga.example.com"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir sunucu adresi değil. Örnek: komga.example.com"
          }
        }
      }
    },
    "account.error.certificate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server zeigt ein Zertifikat, dem dieses Gerät nicht vertraut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server shows a certificate this device doesn't trust."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu, bu cihazın güvenmediği bir sertifika gösteriyor."
          }
        }
      }
    },
    "account.error.foreignServer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier antwortet ein Server, aber nicht der erwartete. Adresse und Art prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server answers here, but not the expected one. Check address and type."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada bir sunucu yanıt veriyor ama beklenen değil. Adresi ve türü kontrol et."
          }
        }
      }
    },
    "account.error.serverDisruption": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist da, aber gestört. Später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is there but not well. Try again later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu orada ama sorunlu. Daha sonra tekrar dene."
          }
        }
      }
    },
    "account.error.store": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet, aber der Schlüsselbund hat das Konto nicht angenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in, but the keychain didn't accept the account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açıldı ama anahtar zinciri hesabı kabul etmedi."
          }
        }
      }
    },
    "account.error.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse antwortet nichts. Adresse prüfen — und ob du im Heimnetz oder im Tunnel bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing answers at this address. Check the address — and whether you're on the home network or the tunnel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adreste yanıt veren yok. Adresi kontrol et — ve ev ağında ya da tünelde olup olmadığını."
          }
        }
      }
    },
