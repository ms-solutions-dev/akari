    "certificate.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server verwendet ein selbst ausgestelltes Zertifikat. Vergleiche den Fingerabdruck mit dem auf dem Server, bevor du vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server uses a self-issued certificate. Compare the fingerprint with the one on the server before you trust it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu kendi imzaladığı bir sertifika kullanıyor. Güvenmeden önce parmak izini sunucudakiyle karşılaştır."
          }
        }
      }
    },
