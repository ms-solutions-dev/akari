          }
        }
      }
    },
    "profile.adopt.question": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandenes Profil „%@“ übernehmen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take over the existing profile “%@”?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut “%@” profili devralınsın mı?"
          }
        }
      }
    },
    "profile.adopt.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gibt es schon ein Profil „%1$@“. Übernehmen bindet es an die Freigabe von %2$@: Lesezeit und Merkliste beider Seiten werden zusammengeführt, Thema und Farbe kommen vom anderen Gerät, Konten und PIN bleiben. Neu anlegen stellt ein zweites Profil daneben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device already has a profile “%1$@”. Taking over links it to the share from %2$@: reading time and saved list from both sides are merged, theme and colour come from the other device, accounts and PIN stay. Create new puts a second profile next to it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda zaten “%1$@” adlı bir profil var. Devralmak onu %2$@ paylaşımına bağlar: her iki taraftaki okuma süresi ve kaydedilenler birleştirilir, tema ve renk diğer cihazdan gelir, hesaplar ve PIN kalır. Yeni oluşturmak yanına ikinci bir profil koyar."
          }
        }
      }
    },
    "profile.adult": {
