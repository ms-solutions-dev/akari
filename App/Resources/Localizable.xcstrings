    "profile.fromDevice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von einem anderen Gerät holen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get from another device"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihazdan al"
          }
        }
      }
    },
    "profile.fromDevice.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest du schon auf einem anderen Gerät? Dort Profil → Verwalten → iCloud & Geräte → Gerät hinzufügen, hier den Code scannen — Statistik, Gemerkt, Thema und Konten kommen mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already reading on another device? There, go to Profile → Manage → iCloud & Devices → Add device and scan the code here — stats, saved list, theme and accounts come along."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihazda zaten okuyor musun? Orada Profil → Yönet → iCloud ve Cihazlar → Cihaz ekle, burada kodu tara — istatistik, kaydedilenler, tema ve hesaplar gelir."
          }
        }
      }
    },
    "profile.kind": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein Kind"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a child"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çocuk için"
          }
        }
      }
    },
    "profile.kind.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kinderprofil zeigt nur Titel bis zum gewählten Alter; Import, Teilen und Abmelden sind aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A child profile shows only titles up to the chosen age; import, sharing and signing out are off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuk profili yalnızca seçilen yaşa kadar olan başlıkları gösterir; içe aktarma, paylaşma ve çıkış kapalıdır."
          }
        }
      }
    },
    "profile.kind.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt nur Titel, deren Altersfreigabe passt — Titel ohne Freigabe zählen als frei. Import, Teilen, Abmelden und Wikipedia sind aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows only titles whose age rating fits — titles without a rating count as free. Import, sharing, signing out and Wikipedia are off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yaş sınırı uyan başlıkları gösterir — sınırı olmayanlar serbest sayılır. İçe aktarma, paylaşma, çıkış ve Wikipedia kapalıdır."
          }
        }
      }
    },
    "profile.manage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönet"
          }
        }
      }
    },
    "profile.manage.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp auf ein Profil, um Name, Farbe, Höchstalter oder PIN zu ändern — oder es zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a profile to change its name, colour, maximum age or PIN — or to remove it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad, renk, üst yaş sınırı veya PIN'i değiştirmek ya da profili kaldırmak için bir profile dokun."
