    "account.opds.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse, die dein Server als OPDS-Katalog nennt. Name und Passwort nur, wenn der Katalog sie verlangt. Der Lesestand bleibt auf diesem Gerät — OPDS kennt keinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address your server lists as its OPDS catalog. Name and password only if the catalog asks for them. Reading progress stays on this device – OPDS has none."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun OPDS kataloğu olarak verdiği adres. Ad ve parola yalnızca katalog istiyorsa. Okuma durumu bu cihazda kalır – OPDS bunu bilmez."
          }
        }
      }
    },
