    "cloud.sharing.finish.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Teilnehmer verlieren den Zugriff; das Profil verschwindet dort. Deine Daten bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All participants lose access; the profile disappears there. Your data stays."
          }
