    "setUp.all.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code hat die Namen mitgebracht. Wo das Passwort anders ist, bleibt die Zeile offen — dort einzeln anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code brought the names along. Where the password differs, the row stays open — sign in there individually."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod adları getirdi. Parolanın farklı olduğu satır açık kalır — orada tek tek oturum aç."
          }
        }
      }
    },
