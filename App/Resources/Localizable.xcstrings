    "cloud.sync.off.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Alles bleibt auf diesem Gerät. Einschalten legt die Daten wieder in deine iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: everything stays on this device. Turning it on puts the data back into your iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: her şey bu cihazda kalır. Açınca veriler yeniden iCloud'una konur."
          }
        }
      }
    },
    "cloud.sync.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesestatistik, Gemerkt und Thema dieses Profils liegen in deiner iCloud und wandern zwischen deinen Geräten. Lesestände bleiben beim Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading stats, saved list and theme of this profile live in your iCloud and travel between your devices. Reading progress stays with the server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin okuma istatistiği, kaydedilenleri ve teması iCloud'unda durur ve cihazların arasında taşınır. Okuma konumları sunucuda kalır."
          }
        }
      }
    },
