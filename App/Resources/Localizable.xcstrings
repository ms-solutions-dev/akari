    "cloud.participant.remove": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldır"
          }
        }
      }
    },
    "cloud.participant.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer die Freigabe angenommen hat — nach Apple-Konto. Nach links wischen entfernt; das Profil verschwindet dort, deine Daten bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who accepted the share — by Apple account. Swipe left to remove; the profile disappears there, your data stays."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşımı kabul edenler — Apple hesabına göre. Sola kaydırarak kaldır; profil orada kaybolur, verilerin kalır."
          }
        }
      }
    },
    "cloud.participant.unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekanntes Konto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown account"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinmeyen hesap"
          }
        }
      }
    },
    "cloud.participant.writing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "lesen und schreiben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "read and write"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "okuma ve yazma"
          }
        }
      }
    },
    "cloud.remove": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus iCloud entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from iCloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud'dan kaldır"
          }
        }
      }
    },
    "cloud.remove.question": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil aus iCloud entfernen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this profile from iCloud?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil iCloud'dan kaldırılsın mı?"
          }
        }
      }
    },
    "cloud.remove.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Daten dieses Profils in deiner iCloud und schaltet den Abgleich aus. Auf diesem Gerät bleibt alles. Andere Geräte behalten ihre Kopie, bekommen aber nichts Neues mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes this profile's data in your iCloud and turns sync off. Everything stays on this device. Other devices keep their copy but receive nothing new."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin iCloud'daki verilerini siler ve eşitlemeyi kapatır. Bu cihazda her şey kalır. Diğer cihazlar kopyalarını korur ama yeni bir şey almaz."
          }
        }
      }
    },
    "cloud.rename": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbenennen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden adlandır"
          }
        }
      }
    },
    "cloud.rename.device.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name gilt für alle, die dieses Profil teilen. Das Gerät setzt ihn nicht mehr auf seinen Systemnamen zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name applies to everyone sharing this profile. The device will no longer reset it to its system name."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad, bu profili paylaşan herkes için geçerlidir. Cihaz onu artık sistem adına geri almaz."
          }
        }
      }
    },
    "cloud.rename.name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad"
          }
        }
      }
    },
    "cloud.rename.participant.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple verrät bei einer Freigabe über den Link nicht, wer beigetreten ist — gib dem Teilnehmer hier einen Namen. Leer lassen entfernt ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a share via link, Apple does not reveal who joined — give the participant a name here. Leave empty to remove it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı üzerinden paylaşımda Apple kimin katıldığını söylemez — katılımcıya burada bir ad ver. Boş bırakmak adı kaldırır."
          }
        }
      }
    },
    "cloud.shared.short": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil ist eine Freigabe eines anderen iCloud-Kontos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile is shared from another iCloud account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil başka bir iCloud hesabından paylaşılıyor."
          }
        }
      }
    },
    "cloud.shared.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik, Gemerkt und Thema kommen aus der iCloud des Besitzers. Verlassen entfernt das Profil hier samt seiner Kopie; beim Besitzer bleibt alles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats, saved list and theme come from the owner's iCloud. Leaving removes the profile here along with its copy; the owner keeps everything."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstatistik, kaydedilenler ve tema sahibinin iCloud'undan gelir. Ayrılmak profili kopyasıyla birlikte buradan kaldırır; sahibinde her şey kalır."
          }
        }
      }
    },
    "cloud.sharedBy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteilt von"
          }
        },
