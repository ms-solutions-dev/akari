        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akari meldet sich, wenn ein Podcast, den du unten auswählst, eine neue Folge hat. Ausgeschaltet kommt keine Mitteilung – deine Auswahl bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Akari lets you know when a podcast you pick below has a new episode. When this is off, nothing is sent – your picks are kept."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıda seçtiğin bir podcast'e yeni bölüm geldiğinde Akari haber verir. Kapalıyken bildirim gelmez – seçimlerin korunur."
