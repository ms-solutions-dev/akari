        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share was revoked — this profile no longer receives updates."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım geri çekildi — bu profil artık güncelleme almıyor."
          }
        }
      }
    },
