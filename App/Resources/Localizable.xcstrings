    "account.catalogs.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kavita, Calibre-Web, Ubooquity — oder Komga und Grimmory über ihren OPDS-Weg. Jeder Katalog ist eine eigene Quelle; der Lesestand bleibt auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kavita, Calibre-Web, Ubooquity – or Komga and Grimmory via their OPDS feed. Each catalog is its own source; reading progress stays on the device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kavita, Calibre-Web, Ubooquity – ya da Komga ve Grimmory’nin OPDS yolu. Her katalog ayrı bir kaynak; okuma durumu cihazda kalır."
          }
        }
      }
    },
