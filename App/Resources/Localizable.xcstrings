          }
        }
      }
    },
    "cloud.leave.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil verschwindet von diesem Gerät samt Konten und Kopie. Beim Besitzer bleibt alles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile disappears from this device along with accounts and copy. The owner keeps everything."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil hesapları ve kopyasıyla birlikte bu cihazdan kaybolur. Sahibinde her şey kalır."
          }
        }
      }
    },
    "cloud.lost": {
