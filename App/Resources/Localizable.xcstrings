    "notifications.moment": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann Akari nachsehen darf, entscheidet iOS – eine Mitteilung kann auch Stunden später kommen. Ist dein Server unterwegs nicht erreichbar, kommt sie, sobald er es wieder ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decides when Akari may check – a notification can arrive hours later. If your server can't be reached while you're away, it arrives once it can."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akari'nin ne zaman kontrol edebileceğine iOS karar verir – bildirim saatler sonra da gelebilir. Sunucuna dışarıdan ulaşılamıyorsa, ulaşılır olduğunda gelir."
          }
        }
      }
    },
