    "cloud.devices.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Gerät eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No device registered yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz cihaz kaydedilmedi."
          }
        }
      }
    },
    "cloud.devices.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Gerät, das dieses Profil abgleicht, trägt sich hier ein. Apple kennt als Teilnehmer nur Apple-Konten: Ein Gerät entfernst du über sein Konto unten — zwei Geräte am selben Konto lassen sich nicht trennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every device that syncs this profile registers here. Apple only knows Apple accounts as participants: you remove a device via its account below — two devices on the same account cannot be separated."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profili eşitleyen her cihaz buraya kaydolur. Apple katılımcı olarak yalnızca Apple hesaplarını tanır: bir cihazı aşağıdaki hesabı üzerinden kaldırırsın — aynı hesaptaki iki cihaz ayrılamaz."
          }
        }
      }
    },
