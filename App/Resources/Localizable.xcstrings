    "welcome.promise.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bücher, Manga und Hörbücher aus Komga, Grimmory, Audiobookshelf, Kavita und OPDS-Katalogen – oder deine eigenen EPUBs. Gelesen wird sofort, der Lesestand bleibt auf deinem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books, manga and audiobooks from Komga, Grimmory, Audiobookshelf, Kavita and OPDS catalogs – or your own EPUBs. Start reading right away; your progress stays on your server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komga, Grimmory, Audiobookshelf, Kavita ve OPDS kataloglarından kitaplar, mangalar ve sesli kitaplar – ya da kendi EPUB dosyaların. Hemen okumaya başla; okuma durumun kendi sunucunda kalır."
          }
        }
      }
    },
